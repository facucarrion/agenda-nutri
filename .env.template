# Copiá este archivo a `.env.local` y completá los valores.
#   Windows (PowerShell):  Copy-Item .env.template .env.local
#   Mac / Linux:           cp .env.template .env.local
# `.env.local` nunca se commitea. Este template solo lleva nombres y valores públicos.
#
# Para trabajar solo en la UI alcanza con las dos primeras variables.

# --- Supabase (públicas: van al navegador, las protege RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://ilqkwirxltvljitajcxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GB3KLYvtnfZfUF_XuYXo4g_qgP5MaBu

# --- Secretas (solo servidor, nunca con prefijo NEXT_PUBLIC_) ---
# Supabase > Project Settings > API Keys. Se saltea RLS. Necesaria para la reserva pública.
SUPABASE_SERVICE_ROLE_KEY=
# https://resend.com > API Keys. Necesaria para enviar emails de confirmación y recordatorio.
RESEND_API_KEY=
# Secreto de los crons (recordatorios y retención). En producción lo envía Vercel.
# Generar uno (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
CRON_SECRET=

# --- Config del servidor ---
# Remitente de los emails. Con el de prueba solo se entrega a la cuenta dueña de Resend.
EMAIL_FROM=Nutri Tu Agenda <onboarding@resend.dev>

# --- Solo producción (Vercel); dejar vacías en local ---
# URL pública para los links de los emails, sin barra final. En local se usa el origen del request.
NEXT_PUBLIC_SITE_URL=
# Poner "true" solo cuando se decida borrar de verdad pacientes sin actividad. Si no, solo simula.
RETENTION_ENFORCE=
